# Server-side only — copy to .env / .env.local and fill in real values.
# On Vercel: Project Settings → Environment Variables.
# These names are read exclusively by server code (api/telegram.ts and the
# local dev middleware); nothing under src/ or public/ may ever read them.
TELEGRAM_BOT_TOKEN=123456789:your-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-chat-id
